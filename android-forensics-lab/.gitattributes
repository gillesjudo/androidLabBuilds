# Enforce LF line endings for Docker and shell scripts on Windows hosts
* text=auto eol=lf
Dockerfile text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sol text eol=lf

# Binary assets
*.apk binary -eol
*.jpg binary -eol
*.png binary -eol
*.db binary -eol
